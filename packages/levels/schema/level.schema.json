{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robonusantara.id/schema/level.schema.json",
  "title": "Level Robo Nusantara",
  "description": "Satu level permainan. Isi peta: . sawah, # pohon, ~ air, p padi, L rangkiang (tujuan), B posisi awal Bima.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "jenjang", "order", "name", "modul", "map", "startDir", "target", "palette", "mission", "hint", "bridge", "solution"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^j[1-5]-[0-9]{2,3}$", "description": "Penanda unik, mis. j1-01" },
    "jenjang": { "type": "integer", "minimum": 1, "maximum": 5 },
    "order": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "modul": { "type": "string" },
    "map": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": { "type": "string", "pattern": "^[.#~pLB]+$", "minLength": 2, "maxLength": 10 }
    },
    "startDir": { "enum": ["N", "E", "S", "W"], "description": "Arah hadap awal: N utara, E timur, S selatan, W barat" },
    "target": { "type": "integer", "minimum": 1, "description": "Jumlah kartu paling hemat (syarat bintang kedua)" },
    "palette": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["maju", "kiri", "kanan", "ulangi"] }
    },
    "mission": { "type": "string" },
    "hint": { "type": "string", "description": "Petunjuk tingkat 1: pertanyaan penuntun" },
    "bridge": { "type": "string", "description": "Tugas Jembatan Dunia Nyata" },
    "solution": { "$ref": "#/$defs/program" },
    "prefill": { "$ref": "#/$defs/program" },
    "tutorial": { "type": "boolean" },
    "feature": { "enum": ["kumbang-galat"] }
  },
  "$defs": {
    "command": { "enum": ["M", "L", "R"], "description": "M maju, L belok kiri, R belok kanan" },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rep", "body"],
      "properties": {
        "rep": { "type": "integer", "minimum": 2, "maximum": 9 },
        "body": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/command" } }
      }
    },
    "program": {
      "type": "array",
      "items": { "oneOf": [{ "$ref": "#/$defs/command" }, { "$ref": "#/$defs/loop" }] }
    }
  }
}
